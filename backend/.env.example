# Database Configuration (supports local Docker PostgreSQL or remote AWS EC2/RDS PostgreSQL)
# Local: postgresql+asyncpg://aicrm:aicrmpassword@127.0.0.1:5432/aicrm
# AWS EC2: postgresql+asyncpg://aicrm:<SECURE_PASSWORD>@<AWS_EC2_PUBLIC_IP>:5432/aicrm
DATABASE_URL=postgresql+asyncpg://aicrm:aicrmpassword@127.0.0.1:5432/aicrm

# Channel Stub Service URL
CHANNEL_STUB_URL=http://127.0.0.1:8001

# App Environment
ENVIRONMENT=development
PORT=8000
